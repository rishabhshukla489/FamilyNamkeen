tent: flex-end;\n}\n\n.card {\n  background: #e2d3bd;\n  padding: 45px 50px;\n  border-radius: 22px;\n  max-width: 520px;\n  color: #2b1b12;\n}\n\n.card-eyebrow {\n  font-size: 12px;\n  letter-spacing: 2px;\n  color: #c23a2b;\n  margin-bottom: 15px;\n}\n\n.card h3 {\n  font-size: 28px;\n  line-height: 1.4;\n  font-weight: 600;\n  margin-bottom: 30px;\n}\n\n/* BRAND LINE */\n.brand-line {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 12px;\n  letter-spacing: 2px;\n  color: #c23a2b;\n}\n\n.brand-line span {\n  width: 25px;\n  height: 2px;\n  background: #c23a2b;\n}\n\n/* MOBILE */\n@media(max-width: 768px) {\n  .story-wrap {\n    flex-direction: column;\n    gap: 40px;\n    text-align: center;\n  }\n\n  .story-left h2 {\n    font-size: 40px;\n  }\n\n  .story-right {\n    justify-content: center;\n  }\n\n  .brand-line {\n    justify-content: center;\n  }\n}\n</style>",
