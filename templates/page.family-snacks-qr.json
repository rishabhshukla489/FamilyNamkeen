      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<div class=\"range-section\">\n  <div class=\"range-header\">\n    <p class=\"sub\">OUR RANGE</p>\n    <h2>Find your krrrunch.</h2>\n    <p class=\"subtitle\">Three rusks. One promise — the perfect crunch in every pack.</p>\n  </div>\n  <div class=\"range-grid\">\n    <!-- CARD 1 -->\n    <div class=\"range-card\">\n      <div class=\"img-wrap\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Classic_Rusk.png?v=1777442862\" alt=\"Classic Rusk\">\n      </div>\n      <p class=\"tag\">CLASSIC</p>\n      <h3>Classic Rusk</h3>\n      <p class=\"desc\">Golden crunch in every slice — Rusk makes tea-time twice as nice!</p>\n      <a href=\"#\">LEARN MORE →</a>\n    </div>\n    <!-- CARD 2 -->\n    <div class=\"range-card\">\n      <div class=\"img-wrap\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/MILK_RUSK.png?v=1777442797\" alt=\"Milk Rusk\">\n      </div>\n      <p class=\"tag\">MILK</p>\n      <h3>Milk Rusk</h3>\n      <p class=\"desc\">Milky richness meets golden crunch — your perfect tea-time treat.</p>\n      <a href=\"#\">LEARN MORE →</a>\n    </div>\n    <!-- CARD 3 -->\n    <div class=\"range-card\">\n      <div class=\"img-wrap\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Elaichee_Rusk.png?v=1777442839\" alt=\"Elaichi Rusk\">\n      </div>\n      <p class=\"tag\">ELAICHI</p>\n      <h3>Elaichi Rusk</h3>\n      <p class=\"desc\">Golden crunch, delicate sweetness — every tea-time made special.</p>\n      <a href=\"#\">LEARN MORE →</a>\n    </div>\n  </div>\n</div>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;600&display=swap');\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .range-section {\n    background: #e8ddd0;\n    padding: 80px 5%;\n    text-align: center;\n    font-family: 'DM Sans', sans-serif;\n    min-height: 100vh;\n  }\n\n  /* HEADER */\n  .range-header .sub {\n    color: #c0392b;\n    font-size: 11px;\n    letter-spacing: 3px;\n    font-weight: 600;\n    margin-bottom: 12px;\n    font-family: 'DM Sans', sans-serif;\n  }\n  .range-header h2 {\n    font-family: 'Playfair Display', serif;\n    font-size: 52px;\n    font-weight: 700;\n    color: #1e1008;\n    margin-bottom: 14px;\n    line-height: 1.1;\n  }\n  .range-header .subtitle {\n    color: #5c4a3d;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.6;\n  }\n\n  /* GRID */\n  .range-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 28px;\n    margin-top: 55px;\n    max-width: 1100px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* CARD */\n  .range-card {\n    background: #ffffff;\n    padding: 35px 28px 30px;\n    border-radius: 22px;\n    text-align: center;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n    box-shadow: 0 2px 12px rgba(0,0,0,0.06);\n  }\n  .range-card:hover {\n    transform: translateY(-6px);\n    box-shadow: 0 12px 32px rgba(0,0,0,0.10);\n  }\n\n  /* IMAGE WRAPPER */\n  .img-wrap {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 24px;\n    overflow: visible;\n  }\n  .img-wrap img {\n    width: 100%;\n    max-width: 260px;\n    height: auto;\n    object-fit: contain;\n    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;\n    display: block;\n  }\n  .range-card:hover .img-wrap img {\n    transform: scale(1.07) translateY(-6px);\n    filter: drop-shadow(0 10px 18px rgba(0,0,0,0.18));\n  }\n\n  /* TAG */\n  .range-card .tag {\n    color: #c0392b;\n    font-size: 11px;\n    letter-spacing: 2.5px;\n    font-weight: 600;\n    margin-bottom: 8px;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  /* TITLE */\n  .range-card h3 {\n    font-family: 'Playfair Display', serif;\n    font-size: 22px;\n    font-weight: 700;\n    color: #1e1008;\n    margin-bottom: 12px;\n  }\n\n  /* DESC */\n  .range-card .desc {\n    font-size: 14px;\n    color: #6b5b4d;\n    margin-bottom: 18px;\n    line-height: 1.6;\n  }\n\n  /* LINK */\n  .range-card a {\n    color: #c0392b;\n    text-decoration: none;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.5px;\n    transition: letter-spacing 0.2s ease;\n    display: inline-block;\n  }\n  .range-card a:hover {\n    letter-spacing: 1.5px;\n  }\n\n  /* MOBILE */\n  @media(max-width: 768px) {\n    .range-grid {\n      grid-template-columns: 1fr;\n    }\n    .range-header h2 {\n      font-size: 36px;\n    }\n  }\n</style>",
