      "settings": {
        "custom_liquid": "<div class=\"tf-wrap\">\n  <p class=\"tf-eyebrow\">WHY FAMILIES TRUST US</p>\n  <h2 class=\"tf-heading\">Made clean. Made with care.</h2>\n\n  <div class=\"tf-grid\">\n\n    <div class=\"tf-card\">\n      <div class=\"tf-icon\">🌿</div>\n      <h3 class=\"tf-title\">100% Vegetarian</h3>\n      <p class=\"tf-desc\">Clean ingredients you can trust.</p>\n    </div>\n\n    <div class=\"tf-card\">\n      <div class=\"tf-icon\">🛡️</div>\n      <h3 class=\"tf-title\">Hygienically Baked</h3>\n      <p class=\"tf-desc\">Controlled, audited manufacturing.</p>\n    </div>\n\n    <div class=\"tf-card\">\n      <div class=\"tf-icon\">📦</div>\n      <h3 class=\"tf-title\">Crunch-Lock Pack</h3>\n      <p class=\"tf-desc\">Sealed for first-bite freshness.</p>\n    </div>\n\n  </div>\n\n  <p class=\"tf-tagline\"><em>Every pack. Every bite. Every time.</em></p>\n</div>\n\n<style>\n  .tf-wrap {\n    background-color: #f5ead8;\n    padding: 72px 20px;\n    text-align: center;\n    font-family: inherit;\n  }\n  .tf-eyebrow {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: #b94040;\n    margin: 0 0 14px;\n  }\n  .tf-heading {\n    font-size: clamp(28px, 4vw, 48px);\n    font-weight: 900;\n    color: #2b1a0e;\n    margin: 0 0 48px;\n    line-height: 1.1;\n  }\n  .tf-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n    max-width: 1100px;\n    margin: 0 auto 40px;\n  }\n  .tf-card {\n    background: #ffffff;\n    border-radius: 20px;\n    padding: 40px 28px 36px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    box-shadow: 0 1px 4px rgba(0,0,0,0.06);\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\n  }\n  .tf-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 8px 24px rgba(0,0,0,0.10);\n  }\n  .tf-icon {\n    width: 72px;\n    height: 72px;\n    background-color: #c0392b;\n    border-radius: 18px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 32px;\n    margin-bottom: 24px;\n  }\n  .tf-title {\n    font-size: 17px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin: 0 0 10px;\n  }\n  .tf-desc {\n    font-size: 14px;\n    color: #777777;\n    margin: 0;\n    line-height: 1.6;\n  }\n  .tf-tagline {\n    font-size: 15px;\n    font-style: italic;\n    color: #8a7060;\n    margin: 0;\n  }\n  @media (max-width: 768px) {\n    .tf-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>",
