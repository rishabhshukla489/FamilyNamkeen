    "custom_liquid_wKyFCd": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.rusk-section {\n  background: #e9dfcf;\n  padding: 80px 20px;\n  text-align: center;\n  font-family: sans-serif;\n}\n\n.rusk-title-small {\n  color: #c44a2f;\n  font-size: 12px;\n  letter-spacing: 2px;\n  margin-bottom: 10px;\n}\n\n.rusk-title {\n  font-size: 48px;\n  font-weight: 700;\n  color: #2d1c0f;\n  margin-bottom: 30px;\n}\n\n.rusk-tabs {\n  display: flex;\n  justify-content: center;\n  gap: 12px;\n  margin-bottom: 40px;\n}\n\n.rusk-tab {\n  padding: 10px 22px;\n  border-radius: 30px;\n  border: 1px solid #c44a2f;\n  cursor: pointer;\n  font-weight: 600;\n  background: transparent;\n}\n\n.rusk-tab.active {\n  background: #c44a2f;\n  color: #fff;\n}\n\n.rusk-card {\n  background: #f3f3f3;\n  border-radius: 20px;\n  padding: 40px;\n  display: flex;\n  align-items: center;\n  gap: 40px;\n  max-width: 1100px;\n  margin: auto;\n  text-align: left;\n}\n\n.rusk-img img {\n  width: 300px;\n}\n\n.rusk-content h3 {\n  font-size: 28px;\n  margin-bottom: 10px;\n}\n\n.rusk-content p {\n  color: #555;\n  margin-bottom: 20px;\n}\n\n.rusk-meta {\n  display: flex;\n  gap: 30px;\n  font-weight: 600;\n}\n\n@media(max-width:768px){\n  .rusk-card {\n    flex-direction: column;\n    text-align: center;\n  }\n}\n</style>\n\n<div class=\"rusk-section\">\n  <div class=\"rusk-title-small\">OUR RANGE</div>\n  <div class=\"rusk-title\">Explore Family Snacks Rusk.</div>\n\n  <div class=\"rusk-tabs\">\n    <div class=\"rusk-tab active\" onclick=\"switchRusk(0)\">CLASSIC</div>\n    <div class=\"rusk-tab\" onclick=\"switchRusk(1)\">MILK</div>\n    <div class=\"rusk-tab\" onclick=\"switchRusk(2)\">ELAICHI</div>\n  </div>\n\n  <div class=\"rusk-card\">\n    <div class=\"rusk-img\">\n      <img id=\"ruskImage\" src=\"YOUR_CLASSIC_IMAGE_URL\">\n    </div>\n    <div class=\"rusk-content\">\n      <small id=\"ruskVariant\">CLASSIC VARIANT</small>\n      <h3 id=\"ruskTitle\">Classic Rusk</h3>\n      <p id=\"ruskDesc\">\n        The rusk that started it all. Hygienically baked, perfectly crunchy, and always consistent — your chai's best companion.\n      </p>\n\n      <div class=\"rusk-meta\">\n        <div>PACK<br>200 g</div>\n        <div>PRICE<br>From ₹5</div>\n        <div>VEG<br>100% Vegetarian</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nconst ruskData = [\n  {\n    img: \"YOUR_CLASSIC_IMAGE_URL\",\n    variant: \"CLASSIC VARIANT\",\n    title: \"Classic Rusk\",\n    desc: \"The rusk that started it all. Hygienically baked, perfectly crunchy, and always consistent — your chai's best companion.\"\n  },\n  {\n    img: \"YOUR_MILK_IMAGE_URL\",\n    variant: \"MILK VARIANT\",\n    title: \"Milk Rusk\",\n    desc: \"Rich milk flavour baked into every bite. The creamier cousin you didn't know you needed — dunk it and discover.\"\n  },\n  {\n    img: \"YOUR_ELAICHI_IMAGE_URL\",\n    variant: \"ELAICHI VARIANT\",\n    title: \"Elaichi Rusk\",\n    desc: \"A whisper of cardamom in every golden bite. Delicate, aromatic, and perfectly balanced — chai's most elegant companion.\"\n  }\n];\n\nfunction switchRusk(index){\n  document.getElementById(\"ruskImage\").src = ruskData[index].img;\n  document.getElementById(\"ruskVariant\").innerText = ruskData[index].variant;\n  document.getElementById(\"ruskTitle\").innerText = ruskData[index].title;\n  document.getElementById(\"ruskDesc\").innerText = ruskData[index].desc;\n\n  document.querySelectorAll(\".rusk-tab\").forEach((tab,i)=>{\n    tab.classList.toggle(\"active\", i === index);\n  });\n}\n</script>",
