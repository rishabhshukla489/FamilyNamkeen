-card p {\n  font-size: 14px;\n  color: #6b5b4d;\n  line-height: 1.5;\n}\n\n/* RESPONSIVE */\n@media(max-width: 1024px) {\n  .science-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media(max-width: 600px) {\n  .science-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .science-title {\n    font-size: 32px;\n  }\n}\n</style>",
