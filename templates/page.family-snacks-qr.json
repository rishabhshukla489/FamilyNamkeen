      "settings": {
        "custom_liquid": "<div class=\"range-section\">\n\n  <div class=\"range-header\">\n    <p class=\"sub\">OUR RANGE</p>\n    <h2>Find your krrrunch.</h2>\n    <p class=\"subtitle\">\n      Three rusks. One promise — the perfect crunch in every pack.\n    </p>\n  </div>\n\n  <div class=\"range-grid\">\n\n    <!-- CARD 1 -->\n    <div class=\"range-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Untitled_design_4_bbffb509-0b42-463c-8492-ec5323896460.png?v=1777363816\">\n      <p class=\"tag\">CLASSIC</p>\n      <h3>Classic Rusk</h3>\n      <p class=\"desc\">Golden crunch in every slice — Rusk makes tea-time twice as nice!</p>\n      <a href=\"#\">LEARN MORE →</a>\n    </div>\n\n    <!-- CARD 2 -->\n    <div class=\"range-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Untitled_design_4_bbffb509-0b42-463c-8492-ec5323896460.png?v=1777363816\">\n      <p class=\"tag\">MILK</p>\n      <h3>Milk Rusk</h3>\n      <p class=\"desc\">Milky richness meets golden crunch — your perfect tea-time treat.</p>\n      <a href=\"#\">LEARN MORE →</a>\n    </div>\n\n    <!-- CARD 3 -->\n    <div class=\"range-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Untitled_design_4_bbffb509-0b42-463c-8492-ec5323896460.png?v=1777363816\">\n      <p class=\"tag\">ELAICHI</p>\n      <h3>Elaichi Rusk</h3>\n      <p class=\"desc\">Golden crunch, delicate sweetness — every tea-time made special.</p>\n      <a href=\"#\">LEARN MORE →</a>\n    </div>\n\n  </div>\n</div>\n\n<style>\n/* SECTION BACKGROUND */\n.range-section {\n  background: #d8cbb6;\n  padding: 80px 5%;\n  text-align: center;\n}\n\n/* HEADER */\n.range-header .sub {\n  color: #c0392b;\n  font-size: 12px;\n  letter-spacing: 2px;\n  margin-bottom: 10px;\n}\n\n.range-header h2 {\n  font-size: 48px;\n  font-weight: 700;\n  color: #2c1b12;\n  margin-bottom: 10px;\n}\n\n.range-header .subtitle {\n  color: #5c4a3d;\n  font-size: 16px;\n}\n\n/* GRID */\n.range-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 30px;\n  margin-top: 50px;\n}\n\n/* CARD */\n.range-card {\n  background: #f2f2f2;\n  padding: 30px 25px;\n  border-radius: 20px;\n  text-align: center;\n  transition: 0.3s;\n}\n\n.range-card:hover {\n  transform: translateY(-5px);\n}\n\n/* IMAGE */\n.range-card img {\n  width: 100%;\n  max-width: 250px;\n  margin-bottom: 20px;\n}\n\n/* TAG */\n.range-card .tag {\n  color: #c0392b;\n  font-size: 12px;\n  letter-spacing: 2px;\n  margin-bottom: 8px;\n}\n\n/* TITLE */\n.range-card h3 {\n  font-size: 22px;\n  color: #2c1b12;\n  margin-bottom: 10px;\n}\n\n/* DESC */\n.range-card .desc {\n  font-size: 14px;\n  color: #6b5b4d;\n  margin-bottom: 15px;\n}\n\n/* LINK */\n.range-card a {\n  color: #c0392b;\n  text-decoration: none;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n/* MOBILE */\n@media(max-width: 768px) {\n  .range-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .range-header h2 {\n    font-size: 32px;\n  }\n}\n</style>",
