      "settings": {
        "custom_liquid": "<div class=\"story-section\">\n  <div class=\"story-wrap\">\n\n    <!-- LEFT -->\n    <div class=\"story-left\">\n      <p class=\"eyebrow\">OUR STORY</p>\n\n      <h2>Your snack time<br>deserves better.</h2>\n\n      <p>\n        Family Snacks Rusk exists for one very serious reason: your snack time deserves better.\n      </p>\n\n      <p>\n        By using a revolutionary process, the perfect krrrunch is baked into every bite — intelligently engineered, made with care.\n      </p>\n\n      <p>\n        No overthinking. No fuss. Just open the pack and let the rusk do the talking.\n      </p>\n\n      <div class=\"quote\">\n        Perfect doesn’t mean fancy. It means it hits just right.\n      </div>\n    </div>\n\n    <!-- RIGHT -->\n    <div class=\"story-right\">\n      <div class=\"card\">\n        <p class=\"card-eyebrow\">OUR PROMISE</p>\n\n        <h3>\n          The perfect crunch in every pack, every bite, every time.\n        </h3>\n\n        <div class=\"brand-line\">\n          <span></span>\n          FAMILY SNACKS RUSK\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.story-section {\n  background: #c23a2b; /* closer to screenshot */\n  padding: 110px 6%;\n  color: #fff;\n}\n\n.story-wrap {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 80px;\n}\n\n/* LEFT SIDE */\n.story-left {\n  flex: 1.2;\n  max-width: 680px;\n}\n\n.eyebrow {\n  font-size: 12px;\n  letter-spacing: 2px;\n  opacity: 0.8;\n  margin-bottom: 18px;\n}\n\n.story-left h2 {\n  font-size: 64px;\n  line-height: 1.1;\n  font-weight: 700;\n  margin-bottom: 25px;\n}\n\n.story-left p {\n  font-size: 16px;\n  line-height: 1.7;\n  margin-bottom: 16px;\n  opacity: 0.95;\n}\n\n/* QUOTE */\n.quote {\n  margin-top: 25px;\n  padding-left: 18px;\n  border-left: 2px solid rgba(255,255,255,0.4);\n  font-style: italic;\n  opacity: 0.9;\n}\n\n/* RIGHT SIDE */\n.story-right {\n  flex: 1;\n  display: flex;\n  justify-content: flex-end;\n}\n\n.card {\n  background: #e2d3bd;\n  padding: 45px 50px;\n  border-radius: 22px;\n  max-width: 520px;\n  color: #2b1b12;\n}\n\n.card-eyebrow {\n  font-size: 12px;\n  letter-spacing: 2px;\n  color: #c23a2b;\n  margin-bottom: 15px;\n}\n\n.card h3 {\n  font-size: 28px;\n  line-height: 1.4;\n  font-weight: 600;\n  margin-bottom: 30px;\n}\n\n/* BRAND LINE */\n.brand-line {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 12px;\n  letter-spacing: 2px;\n  color: #c23a2b;\n}\n\n.brand-line span {\n  width: 25px;\n  height: 2px;\n  background: #c23a2b;\n}\n\n/* MOBILE */\n@media(max-width: 768px) {\n  .story-wrap {\n    flex-direction: column;\n    gap: 40px;\n    text-align: center;\n  }\n\n  .story-left h2 {\n    font-size: 40px;\n  }\n\n  .story-right {\n    justify-content: center;\n  }\n\n  .brand-line {\n    justify-content: center;\n  }\n}\n</style>",
