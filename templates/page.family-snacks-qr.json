        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;600;700&display=swap');\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .rusk-section {\n    background: #f5ead8;\n    padding: 80px 4%;\n    text-align: center;\n\n  }\n\n  .rusk-title-small {\n    color: #c44a2f;\n    font-size: 11px;\n    letter-spacing: 3px;\n    font-weight: 600;\n    margin-bottom: 12px;\n  }\n\n  .rusk-title {\n     \n    font-size: 48px;\n    font-weight: 700;\n    color: #2d1c0f;\n    margin-bottom: 34px;\n  }\n\n  /* TABS */\n  .rusk-tabs {\n    display: flex;\n    justify-content: center;\n    gap: 12px;\n    margin-bottom: 40px;\n  }\n\n  .rusk-tab {\n    padding: 10px 26px;\n    border-radius: 50px;\n    border: 1.5px solid #c44a2f;\n    cursor: pointer;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1px;\n    background: transparent;\n    color: #2d1c0f;\n    transition: background 0.22s ease, color 0.22s ease, transform 0.15s ease;\n  }\n\n  .rusk-tab:hover {\n    transform: translateY(-2px);\n  }\n\n  .rusk-tab.active {\n    background: #c44a2f;\n    color: #fff;\n    border-color: #c44a2f;\n  }\n\n  /* CARD */\n  .rusk-card {\n    background: #ffffff;\n    border-radius: 24px;\n    padding: 48px 52px;\n    display: flex;\n    align-items: center;\n    gap: 52px;\n    max-width: 1100px;\n    margin: 0 auto;\n    text-align: left;\n    box-shadow: 0 4px 24px rgba(0,0,0,0.06);\n    min-height: 320px;\n  }\n\n  /* IMAGE */\n  .rusk-img-wrap {\n    flex-shrink: 0;\n    width: 300px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .rusk-img-wrap img {\n    width: 100%;\n    max-width: 300px;\n    height: auto;\n    object-fit: contain;\n    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1);\n  }\n\n  .rusk-img-wrap img.fade-out {\n    opacity: 0;\n    transform: scale(0.95);\n  }\n\n  .rusk-img-wrap img.fade-in {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  /* DIVIDER */\n  .rusk-divider {\n    width: 1px;\n    height: 180px;\n    background: #e0d5c5;\n    flex-shrink: 0;\n  }\n\n  /* CONTENT */\n  .rusk-content {\n    flex: 1;\n  }\n\n  .rusk-variant-tag {\n    color: #c44a2f;\n    font-size: 11px;\n    letter-spacing: 2.5px;\n    font-weight: 700;\n    margin-bottom: 10px;\n    display: block;\n  }\n\n  .rusk-content h3 {\n     \n    font-size: 36px;\n    font-weight: 700;\n    color: #2d1c0f;\n    margin-bottom: 14px;\n    transition: opacity 0.25s ease;\n  }\n\n  .rusk-content p {\n    color: #6b5b4d;\n    font-size: 15px;\n    line-height: 1.7;\n    margin-bottom: 28px;\n    max-width: 520px;\n    transition: opacity 0.25s ease;\n  }\n\n  .rusk-separator {\n    border: none;\n    border-top: 1px solid #e0d5c5;\n    margin-bottom: 22px;\n  }\n\n  .rusk-meta {\n    display: flex;\n    gap: 40px;\n  }\n\n  .rusk-meta-item .meta-label {\n    font-size: 11px;\n    letter-spacing: 1.5px;\n    color: #9e8c7e;\n    font-weight: 600;\n    margin-bottom: 4px;\n  }\n\n  .rusk-meta-item .meta-value {\n    font-size: 15px;\n    font-weight: 700;\n    color: #2d1c0f;\n  }\n\n  /* MOBILE */\n  @media(max-width: 768px) {\n    .rusk-card {\n      flex-direction: column;\n      text-align: center;\n      padding: 32px 24px;\n      gap: 28px;\n    }\n    .rusk-divider { display: none; }\n    .rusk-title { font-size: 32px; }\n    .rusk-meta { justify-content: center; gap: 24px; }\n    .rusk-content p { max-width: 100%; }\n  }\n</style>\n\n<div class=\"rusk-section\">\n  <div class=\"rusk-title-small\">OUR RANGE</div>\n  <div class=\"rusk-title\">Explore Family Snacks Rusk.</div>\n\n  <div class=\"rusk-tabs\">\n    <div class=\"rusk-tab active\" onclick=\"switchRusk(0)\">CLASSIC</div>\n    <div class=\"rusk-tab\" onclick=\"switchRusk(1)\">MILK</div>\n    <div class=\"rusk-tab\" onclick=\"switchRusk(2)\">ELAICHI</div>\n  </div>\n\n  <div class=\"rusk-card\">\n    <div class=\"rusk-img-wrap\">\n      <img id=\"ruskImage\" src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Classic_Rusk.png?v=1777442862\" alt=\"Rusk\" class=\"fade-in\">\n    </div>\n\n    <div class=\"rusk-divider\"></div>\n\n    <div class=\"rusk-content\">\n      <span class=\"rusk-variant-tag\" id=\"ruskVariant\">CLASSIC VARIANT</span>\n      <h3 id=\"ruskTitle\">Classic Rusk</h3>\n      <p id=\"ruskDesc\">The rusk that started it all. Hygienically baked, perfectly crunchy, and always consistent — your chai's best companion.</p>\n      <hr class=\"rusk-separator\">\n      <div class=\"rusk-meta\">\n        <div class=\"rusk-meta-item\">\n          <div class=\"meta-label\">PACK</div>\n          <div class=\"meta-value\" id=\"ruskPack\">200 g</div>\n        </div>\n        <div class=\"rusk-meta-item\">\n          <div class=\"meta-label\">PRICE</div>\n          <div class=\"meta-value\" id=\"ruskPrice\">From ₹5</div>\n        </div>\n        <div class=\"rusk-meta-item\">\n          <div class=\"meta-label\">VEG</div>\n          <div class=\"meta-value\">100% Vegetarian</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  const ruskData = [\n    {\n      img: \"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Classic_Rusk.png?v=1777442862\",\n      variant: \"CLASSIC VARIANT\",\n      title: \"Classic Rusk\",\n      desc: \"The rusk that started it all. Hygienically baked, perfectly crunchy, and always consistent — your chai's best companion.\",\n      pack: \"200 g\",\n      price: \"From ₹5\"\n    },\n    {\n      img: \"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/MILK_RUSK.png?v=1777442797\",\n      variant: \"MILK VARIANT\",\n      title: \"Milk Rusk\",\n      desc: \"Rich milk flavour baked into every bite. The creamier cousin you didn't know you needed — dunk it and discover.\",\n      pack: \"200 g\",\n      price: \"From ₹5\"\n    },\n    {\n      img: \"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Elaichee_Rusk.png?v=1777442839\",\n      variant: \"ELAICHI VARIANT\",\n      title: \"Elaichi Rusk\",\n      desc: \"A whisper of cardamom in every golden bite. Delicate, aromatic, and perfectly balanced — chai's most elegant companion.\",\n      pack: \"200 g\",\n      price: \"From ₹5\"\n    }\n  ];\n\n  function switchRusk(index) {\n    const img = document.getElementById(\"ruskImage\");\n\n    // fade out\n    img.classList.remove(\"fade-in\");\n    img.classList.add(\"fade-out\");\n\n    setTimeout(() => {\n      img.src = ruskData[index].img;\n      document.getElementById(\"ruskVariant\").innerText = ruskData[index].variant;\n      document.getElementById(\"ruskTitle\").innerText = ruskData[index].title;\n      document.getElementById(\"ruskDesc\").innerText = ruskData[index].desc;\n      document.getElementById(\"ruskPack\").innerText = ruskData[index].pack;\n      document.getElementById(\"ruskPrice\").innerText = ruskData[index].price;\n\n      img.classList.remove(\"fade-out\");\n      img.classList.add(\"fade-in\");\n    }, 250);\n\n    document.querySelectorAll(\".rusk-tab\").forEach((tab, i) => {\n      tab.classList.toggle(\"active\", i === index);\n    });\n  }\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
