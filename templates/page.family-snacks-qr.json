      "settings": {
        "custom_liquid": "<div class=\"custom-hero\">\n  <div class=\"hero-content\">\n    \n    <div class=\"hero-left\">\n      <p class=\"tagline\">PREMIUM QUALITY • DIL SE BANA</p>\n\n      <h1>\n        The rusk with the<br>\n        perfect <span>krrrunch.</span>\n      </h1>\n\n      <p class=\"desc\">\n        Hygienically baked. Crunch-locked. The same satisfying bite,\n        every pack, every time.\n      </p>\n\n      <div class=\"hero-buttons\">\n        <a href=\"#\" class=\"btn-primary\">EXPLORE THE RANGE</a>\n        <a href=\"#\" class=\"btn-link\">Our Story →</a>\n      </div>\n    </div>\n\n    <div class=\"hero-right\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/8522/8003/files/Untitled_design_4_bbffb509-0b42-463c-8492-ec5323896460.png?v=1777363816\" alt=\"Rusk\">\n    </div>\n\n  </div>\n</div>\n\n<style>\n.custom-hero {\n  background: radial-gradient(circle at center, #d8432e 0%, #b83222 100%);\n  padding: 100px 5%;\n  color: #ffffff;\n  position: relative;\n  overflow: hidden;\n}\n\n/* radial rays */\n.custom-hero::before {\n  content: \"\";\n  position: absolute;\n  width: 200%;\n  height: 200%;\n  background: repeating-conic-gradient(\n    rgba(255,255,255,0.05) 0deg 10deg,\n    transparent 10deg 20deg\n  );\n  top: -50%;\n  left: -50%;\n  opacity: 0.25;\n}\n\n/* layout */\n.hero-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 40px;\n  position: relative;\n  z-index: 2;\n}\n\n/* LEFT CONTENT */\n.hero-left {\n  max-width: 620px;\n}\n\n.tagline {\n  font-size: 14px;\n  letter-spacing: 2px;\n  margin-bottom: 15px;\n  color: #ffffff;\n  opacity: 0.9;\n}\n\n.hero-left h1 {\n  font-size: 60px;\n  line-height: 1.2;\n  font-weight: 700;\n  color: #ffffff;\n}\n\n.hero-left h1 span {\n  color: #ffffff;\n  font-style: italic;\n  text-decoration: underline;\n}\n\n.desc {\n  margin: 20px 0;\n  font-size: 18px;\n  color: #ffffff;\n  opacity: 0.9;\n}\n\n/* BUTTONS */\n.hero-buttons {\n  margin-top: 30px;\n}\n\n.btn-primary {\n  background: #ffffff;\n  color: #c0392b;\n  padding: 14px 30px;\n  border-radius: 40px;\n  text-decoration: none;\n  font-weight: 600;\n  margin-right: 15px;\n  display: inline-block;\n  transition: 0.3s ease;\n}\n\n.btn-primary:hover {\n  transform: translateY(-2px);\n}\n\n.btn-link {\n  color: #ffffff;\n  text-decoration: none;\n  font-weight: 500;\n}\n\n/* RIGHT IMAGE */\n.hero-right {\n  flex: 1;\n  display: flex;\n  justify-content: flex-end;\n}\n\n.hero-right img {\n  max-width: 650px;   /* 🔥 bigger image */\n  width: 100%;\n  transform: scale(1.1);\n}\n\n/* MOBILE */\n@media(max-width: 768px) {\n  .hero-content {\n    flex-direction: column;\n    text-align: center;\n  }\n\n  .hero-left h1 {\n    font-size: 38px;\n  }\n\n  .hero-right {\n    justify-content: center;\n  }\n\n  .hero-right img {\n    max-width: 320px;\n    transform: none;\n    margin-top: 20px;\n  }\n}\n</style>",
